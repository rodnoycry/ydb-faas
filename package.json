{
    "name": "@rodnoycry/ydb-faas",
    "version": "2.0.0",
    "description": "Bridges YDB's per-invocation driver requirement in FaaS environments (AWS Lambda, Yandex Cloud Functions, Vercel Functions) with libraries written for traditional, long-lived database connections.",
    "keywords": [
        "ydb",
        "ydbjs",
        "async-local-storage",
        "als",
        "context",
        "serverless",
        "faas",
        "lambda",
        "yandex-cloud-functions",
        "typescript"
    ],
    "homepage": "https://github.com/rodnoycry/ydb-faas#readme",
    "bugs": {
        "url": "https://github.com/rodnoycry/ydb-faas/issues"
    },
    "license": "MIT",
    "author": "Nikita Leontev <ha1ffa@yandex.ru>",
    "contributors": [],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rodnoycry/ydb-faas.git"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "test": "vitest --run",
        "fmt": "biome format --write ./src",
        "lint": "biome lint ./src",
        "ts": "tsc --noEmit",
        "clean": "npx rimraf dist",
        "build": "tsc",
        "attw": "attw --pack --profile esm-only",
        "check": "biome check ./src && tsc --noEmit",
        "build:clean": "pnpm clean && pnpm build",
        "version": "pnpm check && pnpm test && npx changeset version && pnpm install",
        "release": "pnpm check && pnpm test && pnpm build:clean && pnpm attw && npx changeset publish && npx changeset tag",
        "release:ci": "pnpm check && pnpm test && pnpm build:clean && pnpm attw && cross-env NPM_CONFIG_PROVENANCE=true npx changeset publish && npx changeset tag"
    },
    "peerDependencies": {
        "@ydbjs/query": "^6.1.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@biomejs/biome": "^2.4.13",
        "@changesets/cli": "^2.31.0",
        "@types/node": "^25.5.0",
        "@ydbjs/query": "^6.1.0",
        "cross-env": "^10.1.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.5"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "packageManager": "pnpm@10.26.1",
    "engineStrict": true
}
