{
    "name": "@rodnoycry/ydb-utils",
    "version": "0.0.1-alpha",
    "description": "Set of utils for YDB, such as tools allowing handy handling of connection to YDB database in serverless and FaaS environments",
    "keywords": [
        "ydb",
        "utils",
        "tools",
        "typescript"
    ],
    "homepage": "https://github.com/rodnoycry/ydb-utils#readme",
    "bugs": {
        "url": "https://github.com/rodnoycry/ydb-utils/issues"
    },
    "license": "MIT",
    "author": "Nikita Leontev <ha1ffa@yandex.ru>",
    "contributors": [],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rodnoycry/ydb-utils.git"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "test": "vitest --run",
        "fmt": "biome format --write ./src",
        "lint": "biome lint ./src",
        "ts": "tsc --noEmit",
        "clean": "rm -rf dist",
        "build": "tsc",
        "attw": "attw --pack --profile esm-only",
        "check": "biome check ./src && tsc --noEmit",
        "build:clean": "pnpm clean && pnpm build",
        "version": "pnpm check && pnpm test && npx changeset version && pnpm install",
        "publish": "pnpm check && pnpm test && pnpm build:clean && pnpm attw && cross-env NPM_CONFIG_PROVENANCE=true npx changeset publish"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@biomejs/biome": "^2.4.13",
        "@changesets/cli": "^2.31.0",
        "@types/node": "^25.5.0",
        "@ydbjs/auth": "^6.2.1",
        "@ydbjs/core": "^6.1.1",
        "@ydbjs/query": "^6.1.0",
        "cross-env": "^10.1.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.5"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "packageManager": "pnpm@10.26.1",
    "engineStrict": true
}
